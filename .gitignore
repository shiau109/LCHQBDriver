# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Environments (the real ones live at D:\github\.venv-* — never inside a repo)
.venv*/
venv/
env/

# Generated instrument config / data
qblox_state/*.json
data/

# qblox's DUMMY transport assembles Q1ASM through a temp file in the CWD
# (qblox_instruments/ieee488_2/module_dummy_transport.py), so any test run or
# `--dummy` calibration in the repo root drops these.
tmp.q1asm
tmp.hex

# Editor / OS
.vscode/
.idea/
.DS_Store

# Claude Code / agent settings - ALL of it stays local. A committed settings.json
# ships one machine's accumulated permission grants (and its absolute paths) to
# every fork, where they would be pre-approved for someone else's agent.
.claude/settings.json
.claude/settings.local.json
